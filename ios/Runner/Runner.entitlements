<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: must live here (entitlements), NOT in Info.plist.
	     Host must match the reset-password link domain in the email exactly. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:starlink.ardentnetworks.com.ph</string>
		<string>applinks:startlink-sandbox-api.ardentnetworks.com.ph</string>
	</array>
	<!-- APNs (push notifications). "production" is required for TestFlight /
	     App Store; Firebase's APNs .p8 key works for both environments. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
